META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# Radar / Opportunity Engine (intelligence layer)
# News, regional and labour-market signal providers need no key (Google News
# RSS + CBS StatLine open data). Opportunity scoring and content generation
# reuse OPENAI_API_KEY above; set OPENAI_OPPORTUNITY_MODEL only if scoring
# should use a different model than OPENAI_TEXT_MODEL.
OPENAI_OPPORTUNITY_MODEL=
# Optional: enables the Trends signal provider (Google has no free official
# Trends API). Get a key at serpapi.com ("Google Trends" engine).
SERPAPI_API_KEY=
